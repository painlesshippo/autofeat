#!/usr/bin/env sh

set -eu

if command -v mise >/dev/null 2>&1; then
    mise="$(command -v mise)"
elif [ -x "$HOME/.local/bin/mise" ]; then
    mise="$HOME/.local/bin/mise"
else
    printf '%s\n' 'Mise is required to run the pre-commit hook but was not found.' >&2
    exit 1
fi

report_formatting_failure() {
    file="$1"
    formatter="$2"
    details="${3:-}"

    printf '\n[pre-commit] Formatting failed: %s (%s)\n' "$file" "$formatter" >&2
    if [ -n "$details" ]; then
        printf '%s\n' "$details" >&2
    fi
    printf '%s\n' \
        '[pre-commit] Fix and stage the result:' \
        '  mise run format' \
        "  git add -- \"$file\"" >&2
}

check_formatting() {
    printf '%s\n' '[pre-commit] Checking staged file formatting...'

    git diff --cached --name-only --diff-filter=ACMR |
        while IFS= read -r file; do
            [ -n "$file" ] || continue

            case "$file" in
            *.go)
                diff="$(git show ":$file" | "$mise" exec -- gofmt -d)"
                if [ -n "$diff" ]; then
                    report_formatting_failure "$file" gofmt "$diff"
                    return 1
                fi
                ;;
            *.md | *.markdown)
                original="$(git show ":$file")"
                if ! formatted="$(printf '%s\n' "$original" | "$mise" exec -- rumdl fmt --silent --stdin --stdin-filename "$file" 2>&1)"; then
                    report_formatting_failure "$file" rumdl "$formatted"
                    return 1
                fi
                if [ "$original" != "$formatted" ]; then
                    report_formatting_failure "$file" rumdl
                    return 1
                fi
                ;;
            *.sh | .githooks/*)
                if ! diff="$(git show ":$file" | "$mise" exec -- shfmt -d -i 4 --filename "$file" 2>&1)"; then
                    report_formatting_failure "$file" shfmt "$diff"
                    return 1
                fi
                ;;
            *.tmpl)
                original="$(git show ":$file")"
                if ! formatted="$(printf '%s\n' "$original" | "$mise" exec -- gotmplfmt 2>&1)"; then
                    report_formatting_failure "$file" gotmplfmt "$formatted"
                    return 1
                fi
                if [ "$original" != "$formatted" ]; then
                    report_formatting_failure "$file" gotmplfmt
                    return 1
                fi
                ;;
            *.toml)
                original="$(git show ":$file")"
                if ! formatted="$(printf '%s\n' "$original" | "$mise" exec -- taplo format --stdin-filepath "$file" - 2>&1)"; then
                    report_formatting_failure "$file" taplo "$formatted"
                    return 1
                fi
                if [ "$original" != "$formatted" ]; then
                    report_formatting_failure "$file" taplo
                    return 1
                fi
                ;;
            esac
        done
}

check_formatting
printf '%s\n' '[pre-commit] Formatting checks passed.'
